# Run: python3 scripts/init_env.py (creates .env with unique local secrets).
# Then fill in the three provider keys; they can be the same key.
CHAT_API_KEY=replace-with-provider-key
KNOWLEDGE_API_KEY=replace-with-provider-key
EMBEDDING_API_KEY=replace-with-provider-key

# OpenAI-compatible endpoints. Change these if using another provider.
CHAT_API_BASE=https://api.openai.com/v1
CHAT_MODELS=gpt-4.1-mini
KNOWLEDGE_API_BASE=https://api.openai.com/v1
KNOWLEDGE_MODEL=gpt-4.1-mini
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

LIBRECHAT_PORT=3080
LIGHTRAG_PORT=9621
ALLOW_REGISTRATION=true

# Generated by scripts/init_env.py. Do not reuse example values.
MONGO_PASSWORD=GENERATE
POSTGRES_PASSWORD=GENERATE
LIGHTRAG_API_KEY=GENERATE
MCP_TOKEN=GENERATE
CREDS_KEY=GENERATE
CREDS_IV=GENERATE
JWT_SECRET=GENERATE
JWT_REFRESH_SECRET=GENERATE
