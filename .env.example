# Run: python3 scripts/init_env.py (creates .env with unique local secrets).
# Then fill in the chat and knowledge provider keys; they can be the same key.
CHAT_API_KEY=YOUR_CHAT_API_KEY
KNOWLEDGE_API_KEY=YOUR_KNOWLEDGE_API_KEY
EMBEDDING_API_KEY=ollama

# OpenAI-compatible endpoints. Embeddings run on stack-managed Ollama.
CHAT_API_BASE=https://api.openai.com/v1
CHAT_MODELS=gpt-4.1-mini
KNOWLEDGE_API_BASE=https://api.openai.com/v1
KNOWLEDGE_MODEL=gpt-4.1-mini
EMBEDDING_API_BASE=http://ollama:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LIGHTRAG_WORKSPACE=company_bge_m3

LIBRECHAT_PORT=3080
LIGHTRAG_PORT=9621
N8N_PORT=5678
N8N_TIMEZONE=Europe/Rome
ALLOW_REGISTRATION=true

# Generated by scripts/init_env.py. Do not reuse example values.
MONGO_PASSWORD=GENERATE
POSTGRES_PASSWORD=GENERATE
LIGHTRAG_API_KEY=GENERATE
MCP_TOKEN=GENERATE
CREDS_KEY=GENERATE
CREDS_IV=GENERATE
JWT_SECRET=GENERATE
JWT_REFRESH_SECRET=GENERATE

### Number of worker processes, not greater than (2 x number_of_cores) + 1
WORKERS=2
### Number of parallel files to process in one batch
MAX_PARALLEL_INSERT=2
### Max concurrent requests to the LLM
MAX_ASYNC=2

### Max concurrency requests for Embedding
# EMBEDDING_FUNC_MAX_ASYNC=16
# I dropped this to 2 because of rate limit errors with OpenAI
EMBEDDING_FUNC_MAX_ASYNC=2
