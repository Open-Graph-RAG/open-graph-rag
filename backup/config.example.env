# Colon-separated Compose files relative to the repository root.
BACKUP_COMPOSE_FILES=compose.yaml

# Private temporary dumps, lock files and status data.
BACKUP_STATE_DIR=/opt/open-graph-rag/.backup-state

# Alert when the latest complete backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=30
BACKUP_DRILL_MAX_AGE_HOURS=192
BACKUP_MIN_FREE_BYTES=1073741824
BACKUP_COMMAND_TIMEOUT=1800

# The local repository must be distinct from the offsite repository.
RESTIC_REPOSITORY=/srv/open-graph-rag-restic
RESTIC_PASSWORD_FILE=/etc/open-graph-rag/restic-password

# Required, separate offsite repository (for example an S3 URL).
BACKUP_OFFSITE_REPOSITORY=

# Optional S3 credentials may be placed here or supplied by the host environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
